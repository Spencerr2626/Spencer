{
  "mcpServers": {
    "google-drive": {
      "type": "http",
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    },
    "google-sheets": {
      "command": "uvx",
      "args": ["mcp-google-sheets@latest"],
      "env": {
        "SERVICE_ACCOUNT_PATH": "${GOOGLE_SHEETS_SA_PATH}",
        "DRIVE_FOLDER_ID": "${GOOGLE_DRIVE_FOLDER_ID}"
      }
    }
  }
}
